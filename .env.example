# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env yang sudah terisi.

# Koneksi MySQL. Format: mysql://user:password@host:port/nama_database
DATABASE_URL="mysql://root:@localhost:3306/db_flutter"

# Kunci penandatangan JWT. WAJIB diisi dan bersifat rahasia.
# Buat nilai acak dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Port HTTP backend
PORT=3000

# API key Google Gemini untuk fitur chatbot (opsional).
# Ambil di https://aistudio.google.com/app/apikey
# Kosongkan bila fitur chatbot tidak dipakai — endpoint /ai akan menolak dengan pesan jelas.
GEMINI_API_KEY=""

# Origin yang diizinkan mengakses API dari browser, dipisah koma.
# Kosongkan untuk hanya mengizinkan localhost. Isi * untuk mengizinkan semua.
CORS_ORIGINS=""
